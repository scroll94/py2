<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Python Start Kids</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700&family=Nunito:wght@400;600;700;800&display=swap');

        :root {
            --bg: #f8fbff;
            --card: rgba(255, 255, 255, 0.86);
            --text: #17324d;
            --muted: #52718d;
            --blue: #2b7fff;
            --cyan: #29c7d8;
            --orange: #ff9e4f;
            --yellow: #ffd85c;
            --green: #44c48a;
            --pink: #ff6f91;
            --shadow: 0 18px 45px rgba(31, 76, 131, 0.14);
            --radius-xl: 30px;
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            font-family: "Nunito", sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at top left, rgba(255, 216, 92, 0.55), transparent 28%),
                radial-gradient(circle at top right, rgba(41, 199, 216, 0.38), transparent 24%),
                linear-gradient(180deg, #eef8ff 0%, #fef6eb 46%, #f8fbff 100%);
        }

        .floating {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 0;
        }

        .bubble {
            position: absolute;
            border-radius: 999px;
            opacity: 0.22;
            animation: drift 12s ease-in-out infinite;
        }

        .bubble.one {
            width: 180px;
            height: 180px;
            background: #8cd8ff;
            top: 9%;
            left: -45px;
        }

        .bubble.two {
            width: 130px;
            height: 130px;
            background: #ffd85c;
            top: 35%;
            right: 5%;
            animation-delay: -2s;
        }

        .bubble.three {
            width: 220px;
            height: 220px;
            background: #ffbdd5;
            bottom: 4%;
            left: 4%;
            animation-delay: -5s;
        }

        @keyframes drift {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-18px) rotate(7deg); }
        }

        .page {
            position: relative;
            z-index: 1;
            width: min(1180px, calc(100% - 32px));
            margin: 0 auto;
            padding: 24px 0 70px;
        }

        .topbar,
        .hero-card,
        .panel,
        .lesson,
        .quiz,
        .challenge,
        .footer-card {
            background: rgba(255, 255, 255, 0.86);
            border: 1px solid rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow);
            border-radius: var(--radius-xl);
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 22px;
            padding: 16px 22px;
            border-radius: 999px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-badge {
            width: 54px;
            height: 54px;
            display: grid;
            place-items: center;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--blue), var(--cyan));
            color: #fff;
            font-size: 28px;
            box-shadow: 0 12px 24px rgba(43, 127, 255, 0.28);
        }

        .brand strong,
        h1, h2, h3 {
            font-family: "Baloo 2", cursive;
        }

        .brand strong {
            display: block;
            font-size: 1.25rem;
            line-height: 1;
        }

        .brand span,
        .section-note,
        .lesson p,
        .footer-card p,
        .hero p {
            color: var(--muted);
        }

        .nav {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .nav a,
        .hero-actions a,
        .hero-actions button,
        .quiz button {
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .nav a {
            padding: 10px 16px;
            border-radius: 999px;
            color: var(--text);
            background: rgba(255, 255, 255, 0.9);
            font-weight: 700;
        }

        .nav a:hover,
        .hero-actions a:hover,
        .hero-actions button:hover,
        .quiz button:hover {
            transform: translateY(-2px);
        }

        .hero {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 24px;
            margin-bottom: 26px;
        }

        .hero-card,
        .panel,
        .lesson,
        .quiz,
        .challenge,
        .footer-card,
        .operator-card {
            padding: 24px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(41, 199, 216, 0.12);
            color: #15657a;
            font-weight: 800;
            margin-bottom: 16px;
        }

        h1 {
            margin: 0 0 12px;
            font-size: clamp(2.4rem, 5vw, 4.6rem);
            line-height: 0.95;
        }

        .hero-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin: 18px 0 20px;
        }

        .primary-btn,
        .secondary-btn,
        .quiz button {
            padding: 14px 20px;
            border-radius: 16px;
            font-weight: 800;
            font-size: 1rem;
        }

        .primary-btn {
            color: #fff;
            background: linear-gradient(135deg, var(--blue), #4c91ff);
            box-shadow: 0 14px 28px rgba(43, 127, 255, 0.28);
        }

        .secondary-btn {
            color: var(--text);
            background: #fff5d1;
        }

        .hero-stats,
        .lessons,
        .operators,
        .quiz-wrap,
        .challenge-grid,
        .path {
            display: grid;
            gap: 16px;
        }

        .hero-stats { grid-template-columns: repeat(3, 1fr); }
        .lessons { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: 32px; }
        .operators { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: 32px; }
        .quiz-wrap { grid-template-columns: 0.9fr 1.1fr; margin-bottom: 32px; }
        .challenge-grid { grid-template-columns: repeat(3, 1fr); margin-top: 18px; }
        .path { grid-template-columns: repeat(2, 1fr); list-style: none; padding: 0; margin: 0; }

        .stat,
        .path li,
        .quiz-item,
        .task {
            padding: 16px;
            background: rgba(255, 255, 255, 0.92);
            border-radius: 18px;
        }

        .stat strong,
        .lesson h3,
        .section-title,
        .task strong {
            display: block;
            font-family: "Baloo 2", cursive;
        }

        .stat strong { font-size: 1.55rem; }
        .section-title {
            margin: 12px 0 14px;
            font-size: clamp(2rem, 4vw, 3rem);
            line-height: 1;
        }

        .code-preview,
        .mini-code {
            background: #1c2b3f;
            color: #edf6ff;
            border-radius: 22px;
            padding: 18px;
            font-family: Consolas, "Courier New", monospace;
            line-height: 1.6;
            overflow-x: auto;
        }

        .code-preview::before {
            content: "●  ●  ●";
            color: #ffb25c;
            display: block;
            margin-bottom: 12px;
            letter-spacing: 4px;
        }

        .lesson-top {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            align-items: start;
            margin-bottom: 12px;
        }

        .lesson-tag {
            padding: 8px 12px;
            border-radius: 999px;
            font-size: 0.84rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .tag-blue { background: #dbeaff; color: #1b5fcb; }
        .tag-orange { background: #ffead7; color: #c76417; }
        .tag-green { background: #ddf9eb; color: #188b5a; }
        .tag-pink { background: #ffe0ea; color: #c94373; }

        .mini-list {
            margin: 0;
            padding-left: 18px;
        }

        .operator-card {
            border-radius: var(--radius-xl);
            background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
            box-shadow: var(--shadow);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            text-align: left;
            padding: 12px 10px;
            border-bottom: 1px solid #e7eef7;
        }

        th {
            font-size: 0.92rem;
            color: var(--muted);
        }

        .progress-track {
            width: 100%;
            height: 16px;
            border-radius: 999px;
            background: #e4eef8;
            overflow: hidden;
            margin: 18px 0 14px;
        }

        .progress-fill {
            height: 100%;
            width: 14%;
            border-radius: inherit;
            background: linear-gradient(90deg, var(--green), var(--cyan));
            transition: width 0.3s ease;
        }

        .quiz-item label {
            display: block;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .quiz-item input,
        .quiz-item select {
            width: 100%;
            padding: 12px 14px;
            border: 2px solid #d6e3f3;
            border-radius: 14px;
            font: inherit;
            outline: none;
        }

        .quiz-item input:focus,
        .quiz-item select:focus {
            border-color: var(--blue);
        }

        .quiz button {
            color: #fff;
            background: linear-gradient(135deg, var(--pink), #ff8b57);
            box-shadow: 0 14px 28px rgba(255, 111, 145, 0.24);
        }

        .quiz-result {
            margin-top: 14px;
            padding: 15px 16px;
            border-radius: 16px;
            font-weight: 700;
            display: none;
        }

        .quiz-result.show { display: block; }
        .quiz-result.good { background: #ddf9eb; color: #0f7f4e; }
        .quiz-result.mid { background: #fff2c7; color: #8b6500; }
        .quiz-result.low { background: #ffe2e7; color: #a93a60; }

        .footer-card {
            display: flex;
            justify-content: space-between;
            gap: 18px;
            align-items: center;
        }

        .footer-chip {
            padding: 12px 16px;
            border-radius: 999px;
            background: linear-gradient(135deg, #fff2c7, #ffdf80);
            font-weight: 800;
            white-space: nowrap;
        }

        @media (max-width: 980px) {
            .hero,
            .lessons,
            .operators,
            .quiz-wrap,
            .challenge-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 720px) {
            .page {
                width: min(100% - 20px, 1180px);
            }

            .topbar,
            .footer-card {
                display: block;
                border-radius: 26px;
            }

            .hero-stats,
            .path {
                grid-template-columns: 1fr;
            }

            .nav {
                margin-top: 14px;
                justify-content: flex-start;
            }

            h1 {
                line-height: 1.02;
            }
        }
    </style>
</head>
<body>
    <div class="floating">
        <div class="bubble one"></div>
        <div class="bubble two"></div>
        <div class="bubble three"></div>
    </div>

    <div class="page">
        <header class="topbar">
            <div class="brand">
                <div class="brand-badge">{ }</div>
                <div>
                    <strong>Python Start Kids</strong>
                    <span>База Python для детей 10-12 лет</span>
                </div>
            </div>

            <nav class="nav">
                <a href="#lessons">Уроки</a>
                <a href="#operators">Операторы</a>
                <a href="#quiz">Вопросы</a>
                <a href="#practice">Практика</a>
            </nav>
        </header>

        <section class="hero">
            <div class="hero-card">
                <div class="eyebrow">Старт без скуки</div>
                <h1>Учимся Python легко, ярко и по шагам</h1>
                <p>Здесь ребенок может пройти самые первые темы: <b>print</b>, <b>input</b>, <b>int</b>, переменные, арифметику, сравнения, <b>if</b>, логические операторы и циклы.</p>
                <div class="hero-actions">
                    <a class="primary-btn" href="#lessons">Начать уроки</a>
                    <button class="secondary-btn" type="button" id="scrollQuiz">Пройти мини-тест</button>
                </div>
                <div class="hero-stats">
                    <div class="stat"><strong>8</strong><span>главных тем</span></div>
                    <div class="stat"><strong>7</strong><span>вопросов</span></div>
                    <div class="stat"><strong>3</strong><span>мини-задания</span></div>
                </div>
            </div>

            <div>
                <div class="panel" style="margin-bottom: 18px;">
                    <h3>Первый код</h3>
                    <div class="code-preview">name = input("Как тебя зовут? ")
age = int(input("Сколько тебе лет? "))
print("Привет,", name)
print("Через год тебе будет", age + 1)</div>
                </div>

                <div class="panel">
                    <h3>Маршрут обучения</h3>
                    <ul class="path">
                        <li><strong>1. print()</strong> Показываем текст на экране.</li>
                        <li><strong>2. input()</strong> Учимся спрашивать ответ.</li>
                        <li><strong>3. int()</strong> Превращаем текст в число.</li>
                        <li><strong>4. if и циклы</strong> Проверяем условия и повторяем действия.</li>
                    </ul>
                </div>
            </div>
        </section>

        <section id="lessons">
            <h2 class="section-title">Уроки по базе Python</h2>
            <p class="section-note">Короткие карточки объясняют темы просто и по шагам.</p>

            <div class="lessons">
                <article class="lesson">
                    <div class="lesson-top">
                        <h3>1. print()</h3>
                        <span class="lesson-tag tag-blue">Старт</span>
                    </div>
                    <p><b>print()</b> выводит текст на экран.</p>
                    <pre class="mini-code">print("Привет!")
print("Я учу Python")</pre>
                    <ul class="mini-list">
                        <li>Текст пишется в кавычках.</li>
                        <li>Каждый `print()` делает новую строку.</li>
                    </ul>
                </article>

                <article class="lesson">
                    <div class="lesson-top">
                        <h3>2. input()</h3>
                        <span class="lesson-tag tag-orange">Общение</span>
                    </div>
                    <p><b>input()</b> задает вопрос и получает ответ от человека.</p>
                    <pre class="mini-code">name = input("Твое имя: ")
print("Привет,", name)</pre>
                    <ul class="mini-list">
                        <li>Ответ сохраняется в переменную.</li>
                        <li>Сначала это текст.</li>
                    </ul>
                </article>

                <article class="lesson">
                    <div class="lesson-top">
                        <h3>3. int()</h3>
                        <span class="lesson-tag tag-green">Числа</span>
                    </div>
                    <p><b>int()</b> переводит текст в целое число.</p>
                    <pre class="mini-code">age = int(input("Сколько тебе лет? "))
print(age + 1)</pre>
                    <ul class="mini-list">
                        <li>Помогает считать правильно.</li>
                        <li>Нужен после `input()`, если вводишь число.</li>
                    </ul>
                </article>

                <article class="lesson">
                    <div class="lesson-top">
                        <h3>4. Переменные</h3>
                        <span class="lesson-tag tag-pink">Память</span>
                    </div>
                    <p>Переменные хранят данные.</p>
                    <pre class="mini-code">hero = "Алия"
score = 15
print(hero, score)</pre>
                    <ul class="mini-list">
                        <li>`=` сохраняет значение.</li>
                        <li>Имя переменной должно быть понятным.</li>
                    </ul>
                </article>

                <article class="lesson">
                    <div class="lesson-top">
                        <h3>5. Арифметика</h3>
                        <span class="lesson-tag tag-blue">Математика</span>
                    </div>
                    <p>Python умеет складывать, вычитать, умножать и делить.</p>
                    <pre class="mini-code">coins = 10
coins = coins + 5
print(coins)
print(12 / 3)</pre>
                    <ul class="mini-list">
                        <li>`+`, `-`, `*`, `/`, `%`.</li>
                        <li>Можно менять значение переменной.</li>
                    </ul>
                </article>

                <article class="lesson">
                    <div class="lesson-top">
                        <h3>6. if и сравнения</h3>
                        <span class="lesson-tag tag-orange">Проверка</span>
                    </div>
                    <p><b>if</b> помогает программе принять решение.</p>
                    <pre class="mini-code">age = 11
if age >= 10:
    print("Подходишь!")</pre>
                    <ul class="mini-list">
                        <li>После условия ставится `:`.</li>
                        <li>Внутри нужен отступ.</li>
                    </ul>
                </article>

                <article class="lesson">
                    <div class="lesson-top">
                        <h3>7. and, or, not</h3>
                        <span class="lesson-tag tag-green">Логика</span>
                    </div>
                    <p>Эти операторы соединяют условия.</p>
                    <pre class="mini-code">age = 11
likes_code = True

if age >= 10 and likes_code:
    print("Ты в клубе!")</pre>
                    <ul class="mini-list">
                        <li>`and` значит "и".</li>
                        <li>`or` значит "или".</li>
                    </ul>
                </article>

                <article class="lesson">
                    <div class="lesson-top">
                        <h3>8. Циклы</h3>
                        <span class="lesson-tag tag-pink">Повторение</span>
                    </div>
                    <p>Циклы повторяют действия много раз.</p>
                    <pre class="mini-code">for step in range(3):
    print("Шаг", step)

count = 1
while count <= 3:
    print(count)
    count = count + 1</pre>
                    <ul class="mini-list">
                        <li>`for` когда число повторов известно.</li>
                        <li>`while` пока условие верно.</li>
                    </ul>
                </article>
            </div>
        </section>

        <section id="operators">
            <h2 class="section-title">Операторы по базе</h2>
            <p class="section-note">Небольшая шпаргалка по самым важным знакам.</p>

            <div class="operators">
                <div class="operator-card">
                    <h3>Арифметические</h3>
                    <table>
                        <thead>
                            <tr><th>Оператор</th><th>Что делает</th><th>Пример</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>+</td><td>Сложение</td><td>3 + 2 = 5</td></tr>
                            <tr><td>-</td><td>Вычитание</td><td>7 - 4 = 3</td></tr>
                            <tr><td>*</td><td>Умножение</td><td>3 * 4 = 12</td></tr>
                            <tr><td>/</td><td>Деление</td><td>8 / 2 = 4</td></tr>
                            <tr><td>%</td><td>Остаток</td><td>7 % 2 = 1</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="operator-card">
                    <h3>Сравнение и логика</h3>
                    <table>
                        <thead>
                            <tr><th>Оператор</th><th>Что значит</th><th>Пример</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>==</td><td>Равно</td><td>5 == 5</td></tr>
                            <tr><td>!=</td><td>Не равно</td><td>5 != 3</td></tr>
                            <tr><td>&gt;</td><td>Больше</td><td>8 &gt; 2</td></tr>
                            <tr><td>&lt;</td><td>Меньше</td><td>1 &lt; 4</td></tr>
                            <tr><td>&gt;= и &lt;=</td><td>Сравнение с равно</td><td>10 &gt;= 10</td></tr>
                            <tr><td>and, or, not</td><td>Соединяют условия</td><td>age &gt;= 10 and age &lt;= 12</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="quiz-wrap">
            <div class="challenge" id="practice">
                <h2 class="section-title">Мини-практика</h2>
                <p class="section-note">Три идеи для первых программ.</p>
                <div class="challenge-grid">
                    <div class="task"><strong>Задание 1</strong>Спроси имя и выведи приветствие.</div>
                    <div class="task"><strong>Задание 2</strong>Спроси возраст и покажи, сколько будет через год.</div>
                    <div class="task"><strong>Задание 3</strong>Через `if` проверь, подходит ли возраст для клуба 10+.</div>
                </div>
            </div>

            <div class="quiz" id="quiz">
                <h2 class="section-title">Проверь себя</h2>
                <p class="section-note">Ответь на вопросы, и сайт сам покажет результат.</p>

                <div class="progress-track">
                    <div class="progress-fill" id="progressFill"></div>
                </div>

                <div class="quiz-item">
                    <label for="q1">1. Какая команда показывает текст на экране?</label>
                    <select id="q1">
                        <option value="">Выбери ответ</option>
                        <option value="print">print()</option>
                        <option value="input">input()</option>
                        <option value="int">int()</option>
                    </select>
                </div>

                <div class="quiz-item">
                    <label for="q2">2. Что делает input()?</label>
                    <select id="q2">
                        <option value="">Выбери ответ</option>
                        <option value="asks">Спрашивает ответ у пользователя</option>
                        <option value="adds">Складывает числа</option>
                        <option value="loops">Запускает цикл</option>
                    </select>
                </div>

                <div class="quiz-item">
                    <label for="q3">3. Зачем нужен int()?</label>
                    <input id="q3" type="text" placeholder="Напиши: чтобы текст стал числом">
                </div>

                <div class="quiz-item">
                    <label for="q4">4. Какой знак означает 'больше или равно'?</label>
                    <select id="q4">
                        <option value="">Выбери ответ</option>
                        <option value=">=">>=</option>
                        <option value="==">==</option>
                        <option value="!=">!=</option>
                    </select>
                </div>

                <div class="quiz-item">
                    <label for="q5">5. Какой оператор значит 'и'?</label>
                    <select id="q5">
                        <option value="">Выбери ответ</option>
                        <option value="or">or</option>
                        <option value="and">and</option>
                        <option value="not">not</option>
                    </select>
                </div>

                <div class="quiz-item">
                    <label for="q6">6. Что делает if?</label>
                    <input id="q6" type="text" placeholder="Например: проверяет условие">
                </div>

                <div class="quiz-item">
                    <label for="q7">7. Какой цикл удобен, если число повторов уже известно?</label>
                    <select id="q7">
                        <option value="">Выбери ответ</option>
                        <option value="for">for</option>
                        <option value="while">while</option>
                        <option value="if">if</option>
                    </select>
                </div>

                <button type="button" id="checkQuiz">Проверить ответы</button>
                <div class="quiz-result" id="quizResult"></div>
            </div>
        </section>

        <footer>
            <div class="footer-card">
                <div>
                    <h3>Python Start Kids</h3>
                    <p>Яркий стартовый сайт по Python: простые уроки, примеры и вопросы по базе.</p>
                </div>
                <div class="footer-chip">Первый код начинается здесь</div>
            </div>
        </footer>
    </div>

    <script>
        const progressFill = document.getElementById('progressFill');
        const quizInputs = document.querySelectorAll('#quiz select, #quiz input');
        const quizResult = document.getElementById('quizResult');

        function updateProgress() {
            let filled = 0;
            quizInputs.forEach((input) => {
                if (input.value.trim() !== '') filled += 1;
            });
            const percent = Math.max(14, (filled / quizInputs.length) * 100);
            progressFill.style.width = percent + '%';
        }

        quizInputs.forEach((input) => {
            input.addEventListener('input', updateProgress);
            input.addEventListener('change', updateProgress);
        });

        document.getElementById('scrollQuiz').addEventListener('click', () => {
            document.getElementById('quiz').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        document.getElementById('checkQuiz').addEventListener('click', () => {
            let score = 0;
            if (document.getElementById('q1').value === 'print') score++;
            if (document.getElementById('q2').value === 'asks') score++;

            const q3 = document.getElementById('q3').value.toLowerCase();
            if (q3.includes('чис') || q3.includes('number')) score++;

            if (document.getElementById('q4').value === '>=') score++;
            if (document.getElementById('q5').value === 'and') score++;

            const q6 = document.getElementById('q6').value.toLowerCase();
            if (q6.includes('услов') || q6.includes('провер')) score++;

            if (document.getElementById('q7').value === 'for') score++;

            quizResult.className = 'quiz-result show';

            if (score >= 6) {
                quizResult.classList.add('good');
                quizResult.textContent = `Отлично! Ты набрал ${score} из 7. База Python уже хорошо получается.`;
            } else if (score >= 4) {
                quizResult.classList.add('mid');
                quizResult.textContent = `Хороший результат: ${score} из 7. Еще немного практики, и будет совсем уверенно.`;
            } else {
                quizResult.classList.add('low');
                quizResult.textContent = `Пока ${score} из 7. Это нормально для старта. Пролистай уроки еще раз и попробуй снова.`;
            }
        });

        updateProgress();
    </script>
</body>
</html>
